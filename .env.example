# Fallback works without credentials. Use "llm" to call DeepSeek.
CHAT_MODE=fallback
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_LOG_PAYLOADS=false
# Separate credential for the Mistral provider used by Day 5.
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_API_KEY=
# Optional current DeepSeek prices in USD per 1M tokens. Keep 0 to hide cost estimates.
LLM_PRICE_INPUT_CACHE_MISS_PER_MILLION_USD=0
LLM_PRICE_INPUT_CACHE_HIT_PER_MILLION_USD=0
LLM_PRICE_OUTPUT_PER_MILLION_USD=0
DEFAULT_AGENT_ID=general
AGENT_PROFILES_PATTERN=classpath*:agents/*.yml
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Python Agents · День 7. По умолчанию используется настоящий DeepSeek API.
# Установите demo только для локальной проверки без внешнего вызова.
PY_AGENT_MODE=llm
PY_AGENT_API_KEY=
PY_AGENT_BASE_URL=https://api.deepseek.com
PY_AGENT_MODEL=deepseek-v4-flash
PY_AGENT_REQUEST_TIMEOUT_SECONDS=90
PY_AGENT_CORS_ORIGINS=http://localhost:5174,http://localhost:8083
# В Docker путь уже настроен на подключённый volume.
PY_AGENT_DATABASE_PATH=data/agents.sqlite3
